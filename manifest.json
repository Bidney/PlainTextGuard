{
  "manifest_version": 3,
  "name": "PlainText Guard - Safe AI Copy & Paste",
  "short_name": "PlainText Guard",
  "version": "0.3.1",
  "description": "Clean AI-copied text and block secrets before they are pasted into supported AI chats, entirely on-device.",
  "homepage_url": "https://github.com/bidney/PlainTextGuard",
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "PlainText Guard",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*",
        "https://you.com/*",
        "https://huggingface.co/chat/*"
      ],
      "js": [
        "src/rules.js",
        "src/secret-rules.js",
        "src/ai-copy-guard.js",
        "src/paste-guard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-guard": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle PlainText Guard on or off"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
